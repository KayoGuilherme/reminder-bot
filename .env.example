# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=changeme-telegram-bot-token
TELEGRAM_ALLOWED_USER_ID=123456789
GROQ_API_KEY=changeme-groq-api-key
GEMINI_API_KEY=changeme-gemini-api-key

# Database (host "db" is the compose service name)
DB_URL=jdbc:postgresql://db:5432/reminder
DB_USER=reminder
DB_PASSWORD=changeme-db-password

APP_TIMEZONE=America/Fortaleza

# Default language of the bot's messages: en or pt-BR. Replies to a voice/text task follow the language you used.
APP_LANGUAGE=en

# Voice and text tasks. Audio is sent to Groq (speech-to-text) and the text to the LLM provider.
# Language spoken in voice notes (Whisper language code). Empty (default) = auto-detect, so pt and en both work:
# APP_STT_LANGUAGE=
# Chat-completions provider used to parse tasks (default: Groq with GROQ_API_KEY). For Gemini:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=openai/gpt-oss-20b
# LLM_API_KEY=changeme-llm-api-key
# Longest accepted voice note in seconds, and how long an unconfirmed draft stays valid:
# APP_VOICE_MAX_SECONDS=60
# APP_DRAFT_TTL=10m

# Reminder job: set the first to false to turn it off, the second is the wait between runs (default 30s)
# APP_SCHEDULER_ENABLED=true
# APP_SCHEDULER_INTERVAL=30s

# HIGH tasks keep nagging after the deadline: wait between overdue reminders (default 2m) and how many are sent
# before the final "I'll stop reminding you" message (default 10)
# APP_REMINDER_REPEAT_INTERVAL=2m
# APP_REMINDER_MAX_REPEATS=10

# Daily cleanup of DONE and CANCELED tasks older than this many days (default 30, at least 1), and a switch to turn it off
# APP_RETENTION_DAYS=30
# APP_RETENTION_ENABLED=true

# Pause before the one retry of a transient speech-to-text/LLM failure (default 500ms)
# APP_RETRY_BACKOFF=500ms

# Connect and read timeouts of the Telegram client (defaults 5s and 30s)
# APP_TELEGRAM_CONNECT_TIMEOUT=5s
# APP_TELEGRAM_READ_TIMEOUT=30s

# How long shutdown waits for a reminder run in progress (default 30s; compose allows 45s before killing the container)
# APP_SHUTDOWN_TIMEOUT=30s

# Set to false to run without connecting to Telegram (default: true)
# APP_TELEGRAM_ENABLED=true

# MCP server for AI clients (Claude Desktop, Codex, OpenClaw...). Off by default. To turn it on set
# MCP_ENABLED=true and a token of at least 32 characters, for example the output of: openssl rand -hex 32
# MCP_ENABLED=false
# MCP_TOKEN=

# JVM options. Default uses 75% of the machine's RAM as max heap, which is too much on a
# 1 GB server (VM.Standard.E2.1.Micro) that also runs PostgreSQL. Uncomment there:
# JAVA_OPTS=-Xmx256m -XX:+ExitOnOutOfMemoryError -Duser.timezone=UTC

# Optional: published image to run instead of building (see README)
# APP_IMAGE=ghcr.io/OWNER/REPO:latest

# On a server, ignore docker-compose.override.yml (local-dev only) so `docker compose up -d` is safe:
# COMPOSE_FILE=docker-compose.yml
